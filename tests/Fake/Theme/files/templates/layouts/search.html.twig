{% extends 'master.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block main %}
<h1>{{ title }}</h1>
{% include 'partials/search-form.html.twig' with {action: '/search', query: query} only %}
<p role="status">{{ t('%count% results', {'%count%': total}) }}</p>
{% block content %}<ul>{% for result in results %}<li><a href="{{ result.url }}">{{ result.title }}</a> {{ result.excerpt }}</li>{% endfor %}</ul>{% endblock %}
{% endblock %}
